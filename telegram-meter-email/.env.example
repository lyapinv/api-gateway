# Telegram
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-1001234567890
# Optional: comma-separated user IDs allowed to submit readings
TELEGRAM_ALLOWED_USER_IDS=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=meters@example.com
MAIL_TO=uk@example.com
MAIL_SUBJECT=Показания счетчиков за {date}

# Optional path override (default: templates/meter_email.txt)
MAIL_TEMPLATE_PATH=templates/meter_email.txt